# Copy this file to "keystore.properties" (same folder) and fill in your values.
# keystore.properties is gitignored: never commit it, and never commit the .jks file.
#
# storeFile: absolute path to your keystore. Use forward slashes, even on Windows.
storeFile=C:/Users/YOUR_NAME/keystores/pixel-island.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=pixelisland
keyPassword=YOUR_KEY_PASSWORD
