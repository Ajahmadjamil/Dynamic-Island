<?xml version="1.0" encoding="utf-8"?>
<!--
    Pixel Island launcher icon — foreground layer (108×108 adaptive-icon canvas, safe zone is the
    central 66 dp circle). The island mid-split: a black pill with album art + equaliser, and the
    split bubble with a timer arc on its right.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Slightly scaled down around the centre so pill + bubble sit inside every mask shape. -->
    <group
        android:pivotX="54" android:pivotY="54"
        android:scaleX="0.96" android:scaleY="0.96">

        <!-- Drop shadow under the island. -->
        <path
            android:fillColor="#40000000"
            android:pathData="M29,47 H57 A9,9 0 0 1 57,65 H29 A9,9 0 0 1 29,47 Z" />
        <path
            android:fillColor="#40000000"
            android:pathData="M70,56 A9,9 0 1 0 88,56 A9,9 0 1 0 70,56 Z" />

        <!-- The pill. -->
        <path
            android:fillColor="#FF000000"
            android:pathData="M29,45 H57 A9,9 0 0 1 57,63 H29 A9,9 0 0 1 29,45 Z" />
        <!-- Glass rim: light at the top, fading out at the bottom. -->
        <path
            android:pathData="M29,45.4 H57 A8.6,8.6 0 0 1 57,62.6 H29 A8.6,8.6 0 0 1 29,45.4 Z"
            android:strokeWidth="0.8">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="45"
                    android:endX="54" android:endY="63">
                    <item android:offset="0" android:color="#66FFFFFF" />
                    <item android:offset="0.6" android:color="#0DFFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Album art. -->
        <path android:pathData="M25,54 A5,5 0 1 0 35,54 A5,5 0 1 0 25,54 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="25" android:startY="49"
                    android:endX="35" android:endY="59">
                    <item android:offset="0" android:color="#FFFF375F" />
                    <item android:offset="1" android:color="#FFFF9F0A" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Equaliser. -->
        <path
            android:pathData="M45,51.5 V56.5 M49,49.5 V58.5 M53,50.5 V57.5 M57,52 V56"
            android:strokeWidth="2.4"
            android:strokeLineCap="round">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54" android:startY="49"
                    android:endX="54" android:endY="59">
                    <item android:offset="0" android:color="#FF64D2FF" />
                    <item android:offset="1" android:color="#FF30D158" />
                </gradient>
            </aapt:attr>
        </path>

        <!-- Split bubble. -->
        <path
            android:fillColor="#FF000000"
            android:pathData="M70,54 A9,9 0 1 0 88,54 A9,9 0 1 0 70,54 Z" />
        <path
            android:pathData="M70.4,54 A8.6,8.6 0 1 0 87.6,54 A8.6,8.6 0 1 0 70.4,54 Z"
            android:strokeWidth="0.8">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="79" android:startY="45"
                    android:endX="79" android:endY="63">
                    <item android:offset="0" android:color="#66FFFFFF" />
                    <item android:offset="0.6" android:color="#0DFFFFFF" />
                    <item android:offset="1" android:color="#00FFFFFF" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- Timer: faint full ring + bright 3/4 arc. -->
        <path
            android:pathData="M74.4,54 A4.6,4.6 0 1 0 83.6,54 A4.6,4.6 0 1 0 74.4,54"
            android:strokeColor="#4DFF9F0A"
            android:strokeWidth="1.8" />
        <path
            android:pathData="M79,49.4 A4.6,4.6 0 1 1 74.4,54"
            android:strokeColor="#FFFF9F0A"
            android:strokeWidth="1.8"
            android:strokeLineCap="round" />
    </group>
</vector>
