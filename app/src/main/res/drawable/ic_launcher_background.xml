<?xml version="1.0" encoding="utf-8"?>
<!-- Pixel Island launcher icon — background layer (108×108 adaptive-icon canvas). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Midnight → violet diagonal. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FF1A2150" />
                <item android:offset="0.55" android:color="#FF2D1670" />
                <item android:offset="1" android:color="#FF0C0F24" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft blue glow behind the island. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="54"
                android:gradientRadius="40">
                <item android:offset="0" android:color="#806F8BFF" />
                <item android:offset="0.6" android:color="#266F8BFF" />
                <item android:offset="1" android:color="#006F8BFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Faint warm accent, bottom-right, for depth. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="96" android:centerY="100"
                android:gradientRadius="46">
                <item android:offset="0" android:color="#40FF4F8B" />
                <item android:offset="1" android:color="#00FF4F8B" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
